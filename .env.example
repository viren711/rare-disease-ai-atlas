# Copy to .env to override config/atlas.yaml without editing it. All optional.
# Local llama.cpp router started by scripts/serve_llm.sh (or ./start):
LLM_BASE_URL=http://127.0.0.1:8080/v1
# A section name in config/models.ini: qwen2.5-3b (default) | qwen2.5-1.5b | qwen3-4b
LLM_MODEL=qwen2.5-3b
# Not needed for llama.cpp; set if pointing at a hosted OpenAI-compatible endpoint.
# LLM_API_KEY=
# LLM_TEMPERATURE=0.1
# Point the literature RAG at a different index directory (e.g. a --limit smoke index):
# INDEX_DIR=artifacts/index
